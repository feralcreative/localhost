# Harvest OAuth Configuration
HARVEST_CLIENT_ID=your_harvest_client_id_here
HARVEST_CLIENT_SECRET=your_harvest_client_secret_here
HARVEST_ACCOUNT_ID_AGENCY=your_agency_account_id_here
HARVEST_ACCOUNT_NAME_AGENCY=Your Agency Name

# Firebase Configuration (for Harvest token storage)
FIREBASE_USER_ID=your-email@example.com
FIREBASE_FUNCTION_URL=http://127.0.0.1:5001/harvest-feralcreative-co/us-central1/storeHarvestTokens

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Spotify OAuth Configuration
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
